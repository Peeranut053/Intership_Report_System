{
  "info": {
    "_postman_id": "b6f2b8e0-6b7a-4b1a-9b0a-internship-auth-api",
    "name": "Internship System - Auth API",
    "description": "Test collection for the Node/Express + PostgreSQL backend: auth (register/login/me), the admin user-creation endpoint, public lookup data (majors/teachers/mentors), plus the validation, rate-limit, and role-escalation checks added during the security review.\n\nRun order: '0. Admin Setup' first (creates the teacher/mentor accounts a student registration needs to reference), then '1. Happy Path'.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "token", "value": "" },
    { "key": "testEmail", "value": "test1@example.com" },
    { "key": "testPassword", "value": "password123" },
    { "key": "adminApiKey", "value": "dev_only_admin_key_change_me_9f3a7c2e1b" },
    { "key": "testStudentCode", "value": "123456789012" },
    { "key": "testMajorId", "value": "1" },
    { "key": "testAdvisorTeacherId", "value": "" },
    { "key": "testSupervisorTeacherId1", "value": "" },
    { "key": "testSupervisorTeacherId2", "value": "" },
    { "key": "testMentorId", "value": "" },
    { "key": "resetToken", "value": "" },
    { "key": "reportId", "value": "" },
    { "key": "testProvinceId", "value": "20" },
    { "key": "testSchoolDistrictId", "value": "" },
    { "key": "testSubdistrictId", "value": "" }
  ],
  "item": [
    {
      "name": "0. Admin Setup (run first)",
      "item": [
        {
          "name": "Create teacher1 (will be advisor)",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status is 201', function () { pm.response.to.have.status(201); });"] } }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-admin-key", "value": "{{adminApiKey}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"teacher1\",\n  \"email\": \"teacher1@example.com\",\n  \"password\": \"password123\",\n  \"role\": \"teacher\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/admin/users", "host": ["{{baseUrl}}"], "path": ["api", "admin", "users"] }
          }
        },
        {
          "name": "Create teacher2 (will be supervisor 1)",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status is 201', function () { pm.response.to.have.status(201); });"] } }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-admin-key", "value": "{{adminApiKey}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"teacher2\",\n  \"email\": \"teacher2@example.com\",\n  \"password\": \"password123\",\n  \"role\": \"teacher\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/admin/users", "host": ["{{baseUrl}}"], "path": ["api", "admin", "users"] }
          }
        },
        {
          "name": "Create teacher3 (will be supervisor 2)",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status is 201', function () { pm.response.to.have.status(201); });"] } }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-admin-key", "value": "{{adminApiKey}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"teacher3\",\n  \"email\": \"teacher3@example.com\",\n  \"password\": \"password123\",\n  \"role\": \"teacher\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/admin/users", "host": ["{{baseUrl}}"], "path": ["api", "admin", "users"] }
          }
        },
        {
          "name": "Create mentor1",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status is 201', function () { pm.response.to.have.status(201); });"] } }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-admin-key", "value": "{{adminApiKey}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"mentor1\",\n  \"email\": \"mentor1@example.com\",\n  \"password\": \"password123\",\n  \"role\": \"mentor\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/admin/users", "host": ["{{baseUrl}}"], "path": ["api", "admin", "users"] }
          }
        },
        {
          "name": "Get majors (check at least 1 exists)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('At least one major exists', function () {",
                  "    pm.expect(json.majors.length).to.be.above(0);",
                  "});",
                  "if (json.majors && json.majors.length > 0) {",
                  "    pm.collectionVariables.set('testMajorId', json.majors[0].major_id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/majors", "host": ["{{baseUrl}}"], "path": ["api", "majors"] }
          },
          "description": "database/internshipdb.sql does NOT seed the majors table. If this test fails with an empty list, insert at least one row first:\nINSERT INTO majors (major_name) VALUES ('Computer Science');"
        },
        {
          "name": "Get teachers (capture advisor + 2 supervisors)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('At least 3 teachers exist', function () {",
                  "    pm.expect(json.teachers.length).to.be.at.least(3);",
                  "});",
                  "const byName = (n) => (json.teachers || []).find((t) => t.teacher_name === n);",
                  "const t1 = byName('teacher1');",
                  "const t2 = byName('teacher2');",
                  "const t3 = byName('teacher3');",
                  "if (t1) pm.collectionVariables.set('testAdvisorTeacherId', t1.teacher_id);",
                  "if (t2) pm.collectionVariables.set('testSupervisorTeacherId1', t2.teacher_id);",
                  "if (t3) pm.collectionVariables.set('testSupervisorTeacherId2', t3.teacher_id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/teachers", "host": ["{{baseUrl}}"], "path": ["api", "teachers"] }
          }
        },
        {
          "name": "Get mentors (capture mentor)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('At least one mentor exists', function () {",
                  "    pm.expect(json.mentors.length).to.be.above(0);",
                  "});",
                  "const m1 = (json.mentors || []).find((m) => m.mentor_name === 'mentor1');",
                  "if (m1) pm.collectionVariables.set('testMentorId', m1.mentor_id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/mentors", "host": ["{{baseUrl}}"], "path": ["api", "mentors"] }
          }
        }
      ],
      "description": "Run every request in this folder top-to-bottom once (or use Collection Runner) before '1. Happy Path' — Register needs testAdvisorTeacherId/testSupervisorTeacherId1/testSupervisorTeacherId2/testMentorId/testMajorId to already point at real rows."
    },
    {
      "name": "1. Happy Path",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/health", "host": ["{{baseUrl}}"], "path": ["api", "health"] }
          }
        },
        {
          "name": "Register (student)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', function () { pm.response.to.have.status(201); });",
                  "if (pm.response.code === 201) {",
                  "    const json = pm.response.json();",
                  "    pm.collectionVariables.set('token', json.token);",
                  "    pm.test('Role saved as student, not client-supplied value', function () {",
                  "        pm.expect(json.user.role).to.eql('student');",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"testuser1\",\n  \"firstName\": \"ทดสอบ\",\n  \"lastName\": \"ระบบ\",\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\",\n  \"studentCode\": \"{{testStudentCode}}\",\n  \"majorId\": {{testMajorId}},\n  \"internshipPlace\": \"Acme Co., Ltd.\",\n  \"internshipStart\": \"2026-05-01\",\n  \"internshipEnd\": \"2026-08-31\",\n  \"mentorId\": {{testMentorId}},\n  \"advisorTeacherId\": {{testAdvisorTeacherId}},\n  \"supervisorTeacherIds\": [{{testSupervisorTeacherId1}}, {{testSupervisorTeacherId2}}]\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  "    const json = pm.response.json();",
                  "    pm.collectionVariables.set('token', json.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"identifier\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "Me (authenticated)",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status is 200', function () { pm.response.to.have.status(200); });"] } }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "auth", "me"] }
          }
        }
      ]
    },
    {
      "name": "2. Validation & Security Checks",
      "item": [
        {
          "name": "Register - role in body should be ignored (expect role: student)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Role is forced to student, not teacher', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.user.role).to.eql('student');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"wannabe_teacher\",\n  \"email\": \"escalate@example.com\",\n  \"password\": \"password123\",\n  \"role\": \"teacher\",\n  \"studentCode\": \"111111111111\",\n  \"majorId\": {{testMajorId}},\n  \"internshipPlace\": \"Acme Co., Ltd.\",\n  \"internshipStart\": \"2026-05-01\",\n  \"internshipEnd\": \"2026-08-31\",\n  \"mentorId\": {{testMentorId}},\n  \"advisorTeacherId\": {{testAdvisorTeacherId}},\n  \"supervisorTeacherIds\": [{{testSupervisorTeacherId1}}, {{testSupervisorTeacherId2}}]\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] }
          }
        },
        {
          "name": "Register - invalid email format (expect 400)",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status is 400', function () { pm.response.to.have.status(400); });"] } }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"baduser\",\n  \"email\": \"not-an-email\",\n  \"password\": \"password123\",\n  \"studentCode\": \"222222222222\",\n  \"majorId\": {{testMajorId}},\n  \"internshipPlace\": \"Acme Co., Ltd.\",\n  \"internshipStart\": \"2026-05-01\",\n  \"internshipEnd\": \"2026-08-31\",\n  \"mentorId\": {{testMentorId}},\n  \"advisorTeacherId\": {{testAdvisorTeacherId}},\n  \"supervisorTeacherIds\": [{{testSupervisorTeacherId1}}, {{testSupervisorTeacherId2}}]\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] }
          }
        },
        {
          "name": "Register - password too short (expect 400)",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status is 400', function () { pm.response.to.have.status(400); });"] } }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"shortpwuser\",\n  \"email\": \"shortpw@example.com\",\n  \"password\": \"123\",\n  \"studentCode\": \"333333333333\",\n  \"majorId\": {{testMajorId}},\n  \"internshipPlace\": \"Acme Co., Ltd.\",\n  \"internshipStart\": \"2026-05-01\",\n  \"internshipEnd\": \"2026-08-31\",\n  \"mentorId\": {{testMentorId}},\n  \"advisorTeacherId\": {{testAdvisorTeacherId}},\n  \"supervisorTeacherIds\": [{{testSupervisorTeacherId1}}, {{testSupervisorTeacherId2}}]\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] }
          }
        },
        {
          "name": "Register - duplicate email (expect 409)",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status is 409', function () { pm.response.to.have.status(409); });"] } }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"someoneElse\",\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"password123\",\n  \"studentCode\": \"444444444444\",\n  \"majorId\": {{testMajorId}},\n  \"internshipPlace\": \"Acme Co., Ltd.\",\n  \"internshipStart\": \"2026-05-01\",\n  \"internshipEnd\": \"2026-08-31\",\n  \"mentorId\": {{testMentorId}},\n  \"advisorTeacherId\": {{testAdvisorTeacherId}},\n  \"supervisorTeacherIds\": [{{testSupervisorTeacherId1}}, {{testSupervisorTeacherId2}}]\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] }
          }
        },
        {
          "name": "Register - same teacher used twice as supervisor (expect 400)",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status is 400', function () { pm.response.to.have.status(400); });"] } }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"dupesupervisor\",\n  \"email\": \"dupesupervisor@example.com\",\n  \"password\": \"password123\",\n  \"studentCode\": \"555555555555\",\n  \"majorId\": {{testMajorId}},\n  \"internshipPlace\": \"Acme Co., Ltd.\",\n  \"internshipStart\": \"2026-05-01\",\n  \"internshipEnd\": \"2026-08-31\",\n  \"mentorId\": {{testMentorId}},\n  \"advisorTeacherId\": {{testAdvisorTeacherId}},\n  \"supervisorTeacherIds\": [{{testSupervisorTeacherId1}}, {{testSupervisorTeacherId1}}]\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] }
          }
        },
        {
          "name": "Login - wrong password (expect 401)",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status is 401', function () { pm.response.to.have.status(401); });"] } }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"identifier\": \"{{testEmail}}\",\n  \"password\": \"wrongpassword\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "Me - no token (expect 401)",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status is 401', function () { pm.response.to.have.status(401); });"] } }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "auth", "me"] }
          }
        },
        {
          "name": "Me - garbage token (expect 401)",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status is 401', function () { pm.response.to.have.status(401); });"] } }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer not.a.real.token" }],
            "url": { "raw": "{{baseUrl}}/api/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "auth", "me"] }
          }
        }
      ]
    },
    {
      "name": "3. Rate Limit Check (login x12)",
      "item": [
        {
          "name": "Login attempt (run this 12x via Collection Runner)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// On the 11th+ request within 15 minutes from the same IP,",
                  "// this should return 429 instead of 401.",
                  "console.log('Status:', pm.response.code);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"identifier\": \"{{testEmail}}\",\n  \"password\": \"wrongpassword\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          }
        }
      ],
      "description": "Select this folder in Postman's Collection Runner and set Iterations = 12. Requests 1-10 should return 401 (wrong password), request 11+ should return 429 (rate limited)."
    },
    {
      "name": "4. Admin API Security Checks",
      "item": [
        {
          "name": "Create teacher without admin key (expect 401)",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status is 401', function () { pm.response.to.have.status(401); });"] } }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"sneaky\",\n  \"email\": \"sneaky@example.com\",\n  \"password\": \"password123\",\n  \"role\": \"teacher\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/admin/users", "host": ["{{baseUrl}}"], "path": ["api", "admin", "users"] }
          }
        },
        {
          "name": "Create teacher with wrong admin key (expect 401)",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status is 401', function () { pm.response.to.have.status(401); });"] } }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-admin-key", "value": "totally-wrong-key" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"sneaky2\",\n  \"email\": \"sneaky2@example.com\",\n  \"password\": \"password123\",\n  \"role\": \"teacher\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/admin/users", "host": ["{{baseUrl}}"], "path": ["api", "admin", "users"] }
          }
        },
        {
          "name": "Create student via admin without relations (expect 400)",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status is 400', function () { pm.response.to.have.status(400); });"] } }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-admin-key", "value": "{{adminApiKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"incompletestudent\",\n  \"email\": \"incompletestudent@example.com\",\n  \"password\": \"password123\",\n  \"role\": \"student\",\n  \"studentCode\": \"888888888888\",\n  \"majorId\": {{testMajorId}},\n  \"internshipPlace\": \"Acme Co., Ltd.\",\n  \"internshipStart\": \"2026-05-01\",\n  \"internshipEnd\": \"2026-08-31\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/admin/users", "host": ["{{baseUrl}}"], "path": ["api", "admin", "users"] }
          },
          "description": "Omits mentorId/advisorTeacherId/supervisorTeacherIds on purpose — should be rejected the same way register() rejects it."
        }
      ],
      "description": "adminApiKey must match ADMIN_API_KEY in backend/.env exactly for the positive cases in folder 0."
    },
    {
      "name": "5. Forgot / Reset Password",
      "item": [
        {
          "name": "Forgot password - existing account (expect 200, generic message)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response is generic (does not confirm the account exists)', function () {",
                  "    pm.expect(pm.response.json().success).to.eql(true);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"identifier\": \"{{testEmail}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/auth/forgot-password", "host": ["{{baseUrl}}"], "path": ["api", "auth", "forgot-password"] }
          },
