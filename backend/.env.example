# Server
PORT=5000

# Comma-separated list of frontend origins allowed to call this API
CORS_ORIGIN=http://localhost:5173

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=intershipdb

# JWT
JWT_SECRET=changeme_use_a_long_random_value
JWT_EXPIRES_IN=1d

# Admin API key — required to call POST /api/admin/users (creates
# teacher/mentor accounts).
ADMIN_API_KEY=changeme_use_a_long_random_value


FRONTEND_URL=http://localhost:5173


SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Internship System <no-reply@example.com>"
