# Server
PORT=5000

# Comma-separated list of frontend origins allowed to call this API
CORS_ORIGIN=http://localhost:5173

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=changeme
DB_NAME=intershipdb

# JWT
# Required — the server will refuse to start without this set.
# Generate a strong random value, e.g.: openssl rand -hex 32
JWT_SECRET=changeme_use_a_long_random_value
JWT_EXPIRES_IN=1d

# Admin API key — required to call POST /api/admin/users (creates
# teacher/mentor accounts). Sent back as the "x-admin-key" header.
# Generate a strong random value, e.g.: openssl rand -hex 32
ADMIN_API_KEY=changeme_use_a_long_random_value

# Used to build the link inside password-reset emails.
FRONTEND_URL=http://localhost:5173

# SMTP — required for POST /api/auth/forgot-password to send an email.
# Example (Gmail): SMTP_HOST=smtp.gmail.com, SMTP_PORT=587,
# SMTP_SECURE=false, SMTP_USER=you@gmail.com, SMTP_PASS=<App Password>.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Internship System <no-reply@example.com>"
